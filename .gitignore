# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Node
node_modules/
web/dist/
.vite/

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Model weights — the worker downloads these on first run, they never enter git
models/
*.pt
*.pth
*.onnx
*.ckpt

# Audio — uploads, stems, and intermediates. Test fixtures are re-included below.
*.wav
*.mp3
*.flac
*.m4a
*.ogg
!**/tests/fixtures/**

# Local object storage
.minio/
storage/

# Local scratch — CLI output, stems, and whatever gets dropped in while trying
# things out. Audio extensions are already ignored above; this catches the
# documents and stem trees that land beside them.
tmp/

# Agent scratch workspace (ledger, task briefs, review packages)
.superpowers/

